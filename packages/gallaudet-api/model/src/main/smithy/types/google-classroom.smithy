$version: "2"
namespace llc.civictech.school

/// The ID of the current Classroom course.
/// 
/// Based on what I have seen, these identifiers seem to always be twelve-digit 
/// numeric identifiers. This is completely determined by Google, though, and
/// they may change this in the future.
/// 
/// https://shorturl.at/piYHg
@length(min: 12, max: 12)
@pattern("^[0-9]+$")
string ClassroomCourseId

/// A unique identifier for the Google Classroom stream item.
/// 
/// Based on what I have seen, these identifiers seem to always be twelve-digit 
/// numeric identifiers. This is completely determined by Google, though, and
/// they may change this in the future.
/// 
/// https://shorturl.at/piYHg
@length(min: 12, max: 12)
@pattern("^[0-9]+$")
string ClassroomItemId

/// The kind of stream item the user is creating or editing.
///
/// https://shorturl.at/piYHg
enum ClassroomItemType {
    COURSE_WORK = "courseWork"
    COURSE_WORK_MATERIALS = "courseWorkMaterials"
    ANNOUNCEMENT = "announcement"
}

/// Identifier of the Classroom attachment returned by Google.
///
/// This identifier has a one-to-one mapping with the TaskId generated by
/// CivicTech prior to task attachment.
///
/// Based on what I have seen, these identifiers seem to always be twelve-digit 
/// numeric identifiers. This is completely determined by Google, though, and
/// they may change this in the future.
/// 
/// https://shorturl.at/piYHg
@length(min: 12, max: 12)
@pattern("^[0-9]+$")
string ClassroomAttachmentId

/// A token provided by classroom.google.com to the add-on iframe as a query 
/// parameter, which can be used to authorize certain Classroom add-on actions.
/// 
/// https://shorturl.at/piYHg
@sensitive
string AddOnToken